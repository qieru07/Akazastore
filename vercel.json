{
  "version": 2,
  "outputDirectory": "public",
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "routes": [
    {
      "src": "^/images/games/(.*)$",
      "dest": "/akaza_topup/asset/img/$1"
    },
    {
      "src": "^/akaza_topup/topup/rb\\.php$",
      "dest": "/api/akaza_topup/topup/Rb.php"
    },
    {
      "src": "^/akaza_topup/topup/roblox\\.php$",
      "dest": "/api/akaza_topup/topup/Rb.php"
    },
    {
      "src": "^/akaza_topup$",
      "status": 308,
      "headers": { "Location": "/akaza_topup/" }
    },
    {
      "src": "^/akaza_topup/midtrans_webhook\\.php$",
      "dest": "/api/akaza_topup/midtrans_webhook.php",
      "methods": ["GET", "POST"]
    },
    {
      "src": "^/akaza_topup/(.*\\.php)$",
      "dest": "/api/akaza_topup/$1"
    },
    {
      "src": "^/akaza_topup/((?!.*\\.(css|js|png|jpg|jpeg|gif|ico|svg|txt|json|webp|mp4|webm|php)).*)$",
      "dest": "/api/akaza_topup/index.php"
    },
    {
      "src": "^/((?!.*\\.(css|js|png|jpg|jpeg|gif|ico|svg|txt|json|webp|mp4|webm|php)).*)$",
      "dest": "/api/index.php"
    }
  ]
}
