{
  "version": 2,
  "outputDirectory": "public",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4"
    },
    "api/akaza_topup/**/*.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "routes": [
    {
      "src": "/akaza_topup/(.*\\.php)$",
      "dest": "/api/akaza_topup/$1"
    },
    {
      "src": "/akaza_topup$",
      "status": 308,
      "headers": {
        "Location": "/akaza_topup/"
      }
    },
    {
      "src": "/akaza_topup/(.*)",
      "dest": "/api/akaza_topup/index.php"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
