{
  "version": 2,
  "outputDirectory": "public",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4"
    },
    "api/akaza_topup/**/*.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "redirects": [
    {
      "source": "/akaza_topup",
      "destination": "/akaza_topup/",
      "statusCode": 308
    }
  ],
  "rewrites": [
    {
      "source": "/akaza_topup/:path(.*\\.php)",
      "destination": "/api/akaza_topup/:path"
    },
    {
      "source": "/akaza_topup/((?!.*\\.(css|js|png|jpg|jpeg|gif|ico|svg|txt|json|webp|mp4|webm|php)).*)",
      "destination": "/api/akaza_topup/index.php"
    },
    {
      "source": "/((?!api/|.*\\.(css|js|png|jpg|jpeg|gif|ico|svg|txt|json|webp|mp4|webm|php)).*)",
      "destination": "/api/index.php"
    }
  ]
}
